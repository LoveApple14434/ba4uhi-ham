# Copy this file to .env and fill in real values.
# The .env file should stay private (do not commit it, do not put it in the public site root).

PORT=3010
HOST=127.0.0.1

# URL prefix of the admin. Visitors open https://your-domain.example/ba4uhi-admin/
BASE_PATH=/ba4uhi-admin

# Absolute path to the existing data.js used by the public page.
# GitHub Actions deployment keeps the writable data file outside the static tree.
DATA_FILE=/var/www/ba4uhi-data/data.js

# Absolute path for automatic backups. Must be writable by the Node process.
BACKUP_DIR=/opt/ba4uhi-admin/backups

# Use a long random password. At least 12 characters.
ADMIN_PASSWORD=replace-this-with-a-long-random-password

# Set to 1 when the admin is served over HTTPS.
COOKIE_SECURE=1

# Set to 1 when Nginx is in front and forwards X-Forwarded-For.
TRUST_PROXY=1

# Optional. If set, browser writes must come from this exact origin.
PUBLIC_ORIGIN=https://loveapple.space

# Link shown as "查看主页" in the admin header.
SITE_URL=/ba4uhi/

# Optional: mirror every successful write to GitHub.
# Create a fine-grained personal access token limited to this repository,
# with "Contents: Read and write". Do not commit the token.
GITHUB_TOKEN=
GITHUB_REPO=LoveApple14434/ba4uhi-ham
GITHUB_BRANCH=main
GITHUB_DATA_PATH=assets/data.js

# Set to 0 to disable even when token/repo are present.
GITHUB_SYNC=1

# Last successful content SHA; managed automatically. Keep it outside git.
# The default is BACKUP_DIR/github-sync.json, which survives code deploys.
GITHUB_STATE_FILE=/opt/ba4uhi-admin/backups/github-sync.json

# Set to 1 only when you intentionally want to overwrite GitHub with local data,
# even if the repository has records that the online file does not contain.
GITHUB_SYNC_FORCE=0
