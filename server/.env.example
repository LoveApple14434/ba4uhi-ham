# Copy this file to .env and fill in real values.
# The .env file should stay private (do not commit it, do not put it in the public site root).

PORT=3010
HOST=127.0.0.1

# URL prefix of the admin. Visitors open https://your-domain.example/admin/
BASE_PATH=/admin

# Absolute path to the existing data.js used by the public page.
DATA_FILE=/www/wwwroot/ba4uhi/assets/data.js

# Absolute path for automatic backups. Must be writable by the Node process.
BACKUP_DIR=/www/wwwroot/ba4uhi-admin/backups

# Use a long random password. At least 12 characters.
ADMIN_PASSWORD=replace-this-with-a-long-random-password

# Set to 1 when the admin is served over HTTPS.
COOKIE_SECURE=1

# Set to 1 when Nginx is in front and forwards X-Forwarded-For.
TRUST_PROXY=1

# Optional. If set, browser writes must come from this exact origin.
PUBLIC_ORIGIN=https://loveapple.space

# Link shown as "查看主页" in the admin header.
SITE_URL=/blog/QSL-LOG/
